
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the PromptPilot application, storing their preferences and account-related information.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "isProUser": { "type": "boolean" },
        "dailyTaskCount": { "type": "number" },
        "dailyTaskCountResetAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "isProUser", "dailyTaskCount", "dailyTaskCountResetAt", "createdAt", "updatedAt"]
    },
    "AITarget": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AITarget",
      "type": "object",
      "description": "Represents a supported AI model in the fleet.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bestForDescription": { "type": "string" },
        "websiteUrl": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name", "bestForDescription", "websiteUrl"]
    },
    "UserTask": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserTask",
      "type": "object",
      "description": "Represents a single task initiated by a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "initialTaskDescription": { "type": "string" },
        "selectedAITargetId": { "type": "string" },
        "routingExplanation": { "type": "string" },
        "optimizedPrompt": { "type": "string" },
        "taskCategory": { "type": "string" },
        "hasAttachment": { "type": "boolean" },
        "attachmentType": { "type": "string", "enum": ["image", "document", "none"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isBookmarked": { "type": "boolean" }
      },
      "required": ["id", "userId", "initialTaskDescription", "selectedAITargetId", "routingExplanation", "optimizedPrompt", "taskCategory", "createdAt", "updatedAt", "isBookmarked"]
    },
    "PromptIteration": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PromptIteration",
      "type": "object",
      "description": "A specific version of a generated prompt.",
      "properties": {
        "id": { "type": "string" },
        "userTaskId": { "type": "string" },
        "iterationNumber": { "type": "number" },
        "generatedPrompt": { "type": "string" },
        "userFeedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userTaskId", "iterationNumber", "generatedPrompt", "createdAt"]
    },
    "ModelSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ModelSubmission",
      "type": "object",
      "description": "A user-submitted suggestion for a new AI model to be added to the directory.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "modelName": { "type": "string" },
        "modelUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "added"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "modelName", "modelUrl", "createdAt", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profile data."
        }
      },
      {
        "path": "/ai_targets/{aiTargetId}",
        "definition": {
          "entityName": "AITarget",
          "schema": { "$ref": "#/backend/entities/AITarget" },
          "description": "Public AI directory."
        }
      },
      {
        "path": "/users/{userId}/tasks/{userTaskId}",
        "definition": {
          "entityName": "UserTask",
          "schema": { "$ref": "#/backend/entities/UserTask" },
          "description": "User mission tasks."
        }
      },
      {
        "path": "/users/{userId}/tasks/{userTaskId}/prompt_iterations/{promptIterationId}",
        "definition": {
          "entityName": "PromptIteration",
          "schema": { "$ref": "#/backend/entities/PromptIteration" },
          "description": "Prompt iterations."
        }
      },
      {
        "path": "/users/{userId}/model_submissions/{submissionId}",
        "definition": {
          "entityName": "ModelSubmission",
          "schema": { "$ref": "#/backend/entities/ModelSubmission" },
          "description": "User-submitted suggestions for new AI models."
        }
      }
    ]
  }
}
